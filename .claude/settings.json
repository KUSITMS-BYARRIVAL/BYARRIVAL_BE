{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew compileJava:*)",
      "Bash(./gradlew compileTestJava:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh label list:*)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/src/main/resources/application-local.yaml)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/src/main/resources/application-local.yaml)",
      "Bash(git push * main)",
      "Bash(git push * dev)",
      "Bash(git push *:main)",
      "Bash(git push *:dev)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compile-check.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
